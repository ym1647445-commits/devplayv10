[Unit]
Description=DevPlay Item4Gamer Supplier Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devplay
Group=devplay
WorkingDirectory=/opt/devplay-platform
Environment=NODE_ENV=production
EnvironmentFile=/etc/devplay/item4gamer-worker.env
ExecStart=/usr/bin/node /opt/devplay-platform/workers/item4gamer/index.mjs
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/devplay-platform
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target